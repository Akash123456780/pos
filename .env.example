# NEXUS OWNER Platform - Environment Configuration Template
# SECURITY NOTICE: Never place API private keys, JWT secrets, database passwords, or server secrets here.
# Only client-safe public variables prefixed with VITE_ are permitted in frontend code.

# Backend REST API Base URL
VITE_NEXUS_API_BASE_URL="https://api.nexuspos.in"

# Backend Realtime WebSocket Endpoint
VITE_NEXUS_WS_URL="wss://api.nexuspos.in/ws/owner"

# Runtime Environment: 'development' | 'staging' | 'production'
VITE_APP_ENV="development"

# Network request timeout in milliseconds
VITE_API_TIMEOUT_MS=10000

# Mock API Toggle: Set to 'true' for standalone demo, 'false' for strict production backend
VITE_ENABLE_MOCK_API=true

# Offline cache and IndexedDB synchronization enabled
VITE_ENABLE_OFFLINE_MODE=true
